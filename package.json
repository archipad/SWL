{
  "name": "swl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "audit:assistant": "npm run generate:assistant-data && node scripts/audit-assistant-automation.mjs",
    "verify:assistant-dice": "npm run test:assistant-engine && npm run test:assistant-contracts && npm run test:assistant-parcours && npm run audit:assistant",
    "verify": "npm run build",
    "test:assistant-engine": "node scripts/test-assistant-engine.mjs",
    "test:assistant-scenarios": "node scripts/test-assistant-scenarios.mjs",
    "test:assistant-contracts": "node scripts/test-assistant-contracts.mjs",
    "test:import-pipeline": "node scripts/test-import-pipeline.mjs",
    "test:sync-merge": "node scripts/test-sync-merge.mjs",
    "test:user-journeys": "node scripts/test-user-journeys.mjs",
    "test:pdf-catalog-manifest": "node scripts/test-pdf-catalog-manifest.mjs",
    "test:game-day": "node scripts/test-game-day-scenarios.mjs",
    "generate:assistant-data": "node scripts/generate-assistant-reference.mjs && node scripts/generate-card-notes.mjs",
    "build": "npm run test:assistant-engine && npm run test:assistant-scenarios && npm run generate:assistant-data && npm run test:assistant-contracts && npm run test:reference-consistency && npm run test:assistant-parcours && npm run test:import-pipeline && npm run test:sync-merge && npm run test:user-journeys && npm run test:pdf-catalog-manifest && npm run test:game-day && node scripts/audit-assistant-automation.mjs && node scripts/audit-keyword-timing.mjs && node scripts/audit-keyword-surfacing.mjs --check && node scripts/audit-card-effects.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:assistant-parcours": "node scripts/test-assistant-parcours.mjs",
    "test:reference-consistency": "node scripts/test-reference-consistency.mjs",
    "audit:list": "node scripts/audit-list-playthrough.mjs",
    "audit:takras": "node scripts/audit-takras-reference.mjs",
    "audit:keywords": "node scripts/audit-keyword-timing.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^26.1.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
